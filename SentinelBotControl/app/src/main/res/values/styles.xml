<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="SectionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ModeButtonBase">
        <item name="android:layout_width">108dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Solid, high-contrast fill. Each button overrides backgroundTint + textColor
         in the layout for a distinct color per mode, instead of everything sharing
         one faint outline color. -->
    <style name="ModeButton" parent="ModeButtonBase">
        <item name="android:background">@drawable/bg_button_solid</item>
        <item name="android:backgroundTint">@color/mode_normal</item>
        <item name="android:textColor">@color/text_on_light</item>
    </style>

    <!-- Circular duotone mode-icon button (backgroundTint + textColor set per
         instance in the layout so each mode gets its own color). -->
    <style name="ModeCircleButton">
        <item name="android:layout_width">58dp</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:background">@drawable/bg_mode_circle</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="ModeCaption">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="DpadButton">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:background">@drawable/bg_dpad_button</item>
        <item name="android:textColor">@color/accent_cyan</item>
        <item name="android:textSize">20sp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="DpadStopButton" parent="DpadButton">
        <item name="android:background">@drawable/bg_dpad_stop</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

</resources>
